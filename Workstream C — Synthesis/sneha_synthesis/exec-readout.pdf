#!/usr/bin/env python3
"""
Project KAVACH — Executive Readout PDF Generator
Meridian FinServe Pvt. Ltd. · Workstream C Synthesis
"""

from reportlab.lib.pagesizes import A4
from reportlab.lib import colors
from reportlab.lib.units import mm, cm
from reportlab.lib.styles import getSampleStyleSheet, ParagraphStyle
from reportlab.lib.enums import TA_LEFT, TA_CENTER, TA_JUSTIFY, TA_RIGHT
from reportlab.platypus import (
    SimpleDocTemplate, Paragraph, Spacer, Table, TableStyle,
    HRFlowable, PageBreak, KeepTogether
)
from reportlab.pdfgen import canvas
from reportlab.lib.colors import HexColor
import io

# ── Brand colours ──────────────────────────────────────────────────────────────
NAVY       = HexColor('#1B2A4A')
DARK_BLUE  = HexColor('#1E3A5F')
MID_BLUE   = HexColor('#2E6DA4')
LIGHT_BLUE = HexColor('#D5E8F0')
GOLD       = HexColor('#C9A84C')
RED_CRIT   = HexColor('#DC2626')
RED_BG     = HexColor('#FEF2F2')
ORANGE     = HexColor('#D97706')
ORANGE_BG  = HexColor('#FFFBEB')
GREEN      = HexColor('#059669')
GREEN_BG   = HexColor('#ECFDF5')
GREY_LIGHT = HexColor('#F3F4F6')
GREY_MED   = HexColor('#6B7280')
GREY_DARK  = HexColor('#374151')
WHITE      = colors.white
BLACK      = colors.black

PAGE_W, PAGE_H = A4
MARGIN = 2.0 * cm

# ── Page template with header/footer ──────────────────────────────────────────
class KavachCanvas(canvas.Canvas):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self._page_num = 0

    def showPage(self):
        self._page_num += 1
        self._draw_page_furniture()
        super().showPage()

    def save(self):
        self._page_num += 1
        self._draw_page_furniture()
        super().save()

    def _draw_page_furniture(self):
        w, h = A4
        self.saveState()

        # Top accent bar
        self.setFillColor(NAVY)
        self.rect(0, h - 14*mm, w, 14*mm, fill=1, stroke=0)

        # Header text
        self.setFillColor(WHITE)
        self.setFont('Helvetica-Bold', 8)
        self.drawString(MARGIN, h - 9*mm, 'PROJECT KAVACH  ·  EXECUTIVE READOUT')
        self.setFont('Helvetica', 8)
        self.drawRightString(w - MARGIN, h - 9*mm, 'CONFIDENTIAL · NOT FOR REDISTRIBUTION')

        # Gold accent line under header
        self.setStrokeColor(GOLD)
        self.setLineWidth(1.5)
        self.line(MARGIN, h - 15.5*mm, w - MARGIN, h - 15.5*mm)

        # Bottom footer line
        self.setStrokeColor(GREY_MED)
        self.setLineWidth(0.5)
        self.line(MARGIN, 16*mm, w - MARGIN, 16*mm)

        # Footer text
        self.setFillColor(GREY_MED)
        self.setFont('Helvetica', 7)
        self.drawString(MARGIN, 10*mm, 'Meridian FinServe Pvt. Ltd.  ·  Futurense AI Clinic  ·  IIT Roorkee × Futurense Technologies')
        self.drawRightString(w - MARGIN, 10*mm, f'Page {self._page_num}')

        self.restoreState()


def build_styles():
    styles = getSampleStyleSheet()

    base = dict(fontName='Helvetica', fontSize=10, leading=15,
                textColor=GREY_DARK, spaceAfter=6)

    custom = {
        'Cover_Title': ParagraphStyle('Cover_Title',
            fontName='Helvetica-Bold', fontSize=36, leading=42,
            textColor=WHITE, spaceBefore=0, spaceAfter=8),
        'Cover_Sub': ParagraphStyle('Cover_Sub',
            fontName='Helvetica', fontSize=14, leading=20,
            textColor=LIGHT_BLUE, spaceBefore=0, spaceAfter=6),
        'Cover_Label': ParagraphStyle('Cover_Label',
            fontName='Helvetica', fontSize=9, leading=12,
            textColor=GOLD, spaceBefore=0, spaceAfter=2),
        'H1': ParagraphStyle('H1',
            fontName='Helvetica-Bold', fontSize=18, leading=24,
            textColor=NAVY, spaceBefore=18, spaceAfter=8,
            borderPad=4),
        'H2': ParagraphStyle('H2',
            fontName='Helvetica-Bold', fontSize=13, leading=18,
            textColor=DARK_BLUE, spaceBefore=14, spaceAfter=6),
        'H3': ParagraphStyle('H3',
            fontName='Helvetica-Bold', fontSize=11, leading=15,
            textColor=MID_BLUE, spaceBefore=10, spaceAfter=4),
        'Body': ParagraphStyle('Body', **base),
        'BodyJust': ParagraphStyle('BodyJust',
            fontName='Helvetica', fontSize=10, leading=15,
            textColor=GREY_DARK, spaceAfter=6,
            alignment=TA_JUSTIFY),
        'Bold': ParagraphStyle('Bold',
            fontName='Helvetica-Bold', fontSize=10, leading=15,
            textColor=GREY_DARK, spaceAfter=4),
        'Small': ParagraphStyle('Small',
            fontName='Helvetica', fontSize=8.5, leading=12,
            textColor=GREY_MED, spaceAfter=4),
        'TableHeader': ParagraphStyle('TableHeader',
            fontName='Helvetica-Bold', fontSize=8.5, leading=11,
            textColor=WHITE),
        'TableCell': ParagraphStyle('TableCell',
            fontName='Helvetica', fontSize=8.5, leading=12,
            textColor=GREY_DARK),
        'TableCellBold': ParagraphStyle('TableCellBold',
            fontName='Helvetica-Bold', fontSize=8.5, leading=12,
            textColor=GREY_DARK),
        'Bullet': ParagraphStyle('Bullet',
            fontName='Helvetica', fontSize=10, leading=15,
            textColor=GREY_DARK, leftIndent=16, spaceAfter=4,
            bulletIndent=4, bulletText='•'),
        'CalloutTitle': ParagraphStyle('CalloutTitle',
            fontName='Helvetica-Bold', fontSize=9, leading=12,
            textColor=NAVY, spaceAfter=2),
        'CalloutBody': ParagraphStyle('CalloutBody',
            fontName='Helvetica', fontSize=9, leading=13,
            textColor=GREY_DARK),
        'RightAlign': ParagraphStyle('RightAlign',
            fontName='Helvetica', fontSize=9, leading=12,
            textColor=GREY_MED, alignment=TA_RIGHT),
        'CenterAlign': ParagraphStyle('CenterAlign',
            fontName='Helvetica-Bold', fontSize=10, leading=14,
            textColor=NAVY, alignment=TA_CENTER),
    }
    return custom


def section_title(title, styles):
    """Returns a styled section heading with gold underline."""
    items = []
    items.append(Paragraph(title, styles['H1']))
    items.append(HRFlowable(width='100%', thickness=2, color=GOLD,
                            spaceAfter=8))
    return items


def callout_box(title, body_lines, styles, bg=LIGHT_BLUE, border=MID_BLUE):
    """Shaded callout box."""
    content = [Paragraph(title, styles['CalloutTitle'])]
    for line in body_lines:
        content.append(Paragraph(line, styles['CalloutBody']))
    t = Table([[content]], colWidths=[PAGE_W - 2*MARGIN])
    t.setStyle(TableStyle([
        ('BACKGROUND', (0,0), (-1,-1), bg),
        ('BOX', (0,0), (-1,-1), 1.5, border),
        ('LEFTPADDING', (0,0), (-1,-1), 12),
        ('RIGHTPADDING', (0,0), (-1,-1), 12),
        ('TOPPADDING', (0,0), (-1,-1), 10),
        ('BOTTOMPADDING', (0,0), (-1,-1), 10),
    ]))
    return t


def risk_badge(label, color, bg):
    return Table([[Paragraph(f'<b>{label}</b>',
                             ParagraphStyle('Badge', fontName='Helvetica-Bold',
                                            fontSize=8, textColor=color,
                                            alignment=TA_CENTER))]],
                 colWidths=[52])


def make_table(headers, rows, styles, col_widths=None):
    """Build a styled data table."""
    header_row = [Paragraph(h, styles['TableHeader']) for h in headers]
    data = [header_row]
    for row in rows:
        data.append([Paragraph(str(c), styles['TableCell']) for c in row])

    if col_widths is None:
        available = PAGE_W - 2*MARGIN
        col_widths = [available / len(headers)] * len(headers)

    t = Table(data, colWidths=col_widths, repeatRows=1)
    ts = TableStyle([
        ('BACKGROUND', (0,0), (-1,0), NAVY),
        ('TEXTCOLOR', (0,0), (-1,0), WHITE),
        ('FONTNAME', (0,0), (-1,0), 'Helvetica-Bold'),
        ('FONTSIZE', (0,0), (-1,0), 8.5),
        ('ROWBACKGROUNDS', (0,1), (-1,-1), [WHITE, GREY_LIGHT]),
        ('GRID', (0,0), (-1,-1), 0.5, HexColor('#D1D5DB')),
        ('LEFTPADDING', (0,0), (-1,-1), 8),
        ('RIGHTPADDING', (0,0), (-1,-1), 8),
        ('TOPPADDING', (0,0), (-1,-1), 6),
        ('BOTTOMPADDING', (0,0), (-1,-1), 6),
        ('VALIGN', (0,0), (-1,-1), 'TOP'),
    ])
    t.setStyle(ts)
    return t


def build_cover_page(styles):
    """Build a full-page dark cover."""
    story = []

    # Full-page navy background using a 1-cell table
    cover_content = [
        Spacer(1, 1.5*cm),
        Paragraph('CONFIDENTIAL · EXECUTIVE READOUT', styles['Cover_Label']),
        Paragraph('Project', styles['Cover_Sub']),
        Paragraph('KAVACH', styles['Cover_Title']),
        Spacer(1, 0.3*cm),
        HRFlowable(width='60%', thickness=1.5, color=GOLD, spaceAfter=14),
        Paragraph('A Two-Surface Security Assessment for a Fictional Non-Banking Financial Enterprise',
                  styles['Cover_Sub']),
        Spacer(1, 1.5*cm),
        Paragraph('CLIENT', styles['Cover_Label']),
        Paragraph('Meridian FinServe Pvt. Ltd. (Fictional NBFC)', styles['Cover_Sub']),
        Spacer(1, 0.6*cm),
        Paragraph('PROGRAMME', styles['Cover_Label']),
        Paragraph('PG Certification in AI-Enabled Cybersecurity', styles['Cover_Sub']),
        Spacer(1, 0.3*cm),
        Paragraph('IIT Roorkee × Futurense Technologies', styles['Cover_Sub']),
        Spacer(1, 1.8*cm),
        HRFlowable(width='100%', thickness=0.5, color=GOLD, spaceAfter=10),
        Paragraph('SPRINT 2–3 · WORKSTREAM C SYNTHESIS · VERSION 1.0 · JUNE 2026',
                  ParagraphStyle('FootNote', fontName='Helvetica', fontSize=8,
                                 leading=12, textColor=GOLD)),
    ]

    cover_table = Table([[cover_content]],
                        colWidths=[PAGE_W - 2*MARGIN],
                        rowHeights=[PAGE_H - 6*cm])
    cover_table.setStyle(TableStyle([
        ('BACKGROUND', (0,0), (-1,-1), NAVY),
        ('LEFTPADDING', (0,0), (-1,-1), 28),
        ('RIGHTPADDING', (0,0), (-1,-1), 28),
        ('TOPPADDING', (0,0), (-1,-1), 28),
        ('BOTTOMPADDING', (0,0), (-1,-1), 28),
        ('VALIGN', (0,0), (-1,-1), 'TOP'),
    ]))
    story.append(cover_table)
    story.append(PageBreak())
    return story


def build_toc(styles):
    story = []
    story += section_title('Table of Contents', styles)
    toc_items = [
        ('1', 'Executive Summary', '3'),
        ('2', 'Business Context', '4'),
        ('3', 'Assessment Scope', '4'),
        ('4', 'Key Findings', '5'),
        ('5', 'Threat Landscape', '6'),
        ('6', 'Top Five Risks', '7'),
        ('7', 'Combined Attack Narrative', '8'),
        ('8', 'Impact Analysis', '9'),
        ('9', 'Risk Heat Map', '10'),
        ('10', 'Strategic Recommendations', '10'),
        ('11', 'Quick Wins', '11'),
        ('12', '30 / 60 / 90-Day Roadmap', '12'),
        ('13', 'Conclusion', '13'),
    ]
    rows = [[f'{n}.', title, pg] for n, title, pg in toc_items]
    col_w = [1.2*cm, PAGE_W - 2*MARGIN - 3.2*cm, 2.0*cm]
    tbl = make_table(['#', 'Section', 'Page'], rows, styles, col_widths=col_w)
    story.append(tbl)
    story.append(PageBreak())
    return story


def build_exec_summary(styles):
    story = []
    story += section_title('1. Executive Summary', styles)

    story.append(Paragraph(
        'Meridian FinServe commissioned this assessment following two concurrent security signals: '
        'a 72-hour window of anomalous east-west and outbound network traffic from a historically '
        'stable server segment, and a coordinated bug-bounty disclosure confirming SQL injection '
        'and Insecure Direct Object Reference (IDOR) vulnerabilities on its customer-facing portal. '
        'The board\'s hypothesis — that the two signals are related — is <b>substantiated</b> by '
        'this engagement.', styles['BodyJust']))

    story.append(Spacer(1, 8))

    # Three-column stat callout
    stat_data = [
        [Paragraph('<b>2</b>', ParagraphStyle('Big', fontName='Helvetica-Bold',
                                               fontSize=32, textColor=RED_CRIT,
                                               alignment=TA_CENTER)),
         Paragraph('<b>15</b>', ParagraphStyle('Big', fontName='Helvetica-Bold',
                                                fontSize=32, textColor=ORANGE,
                                                alignment=TA_CENTER)),
         Paragraph('<b>3</b>', ParagraphStyle('Big', fontName='Helvetica-Bold',
                                               fontSize=32, textColor=MID_BLUE,
                                               alignment=TA_CENTER))],
        [Paragraph('CRITICAL Risks\nActive · Regulator-Reportable',
                   ParagraphStyle('StatLabel', fontName='Helvetica', fontSize=9,
                                  textColor=GREY_DARK, alignment=TA_CENTER, leading=13)),
         Paragraph('Risks Identified\nAcross Both Surfaces',
                   ParagraphStyle('StatLabel', fontName='Helvetica', fontSize=9,
                                  textColor=GREY_DARK, alignment=TA_CENTER, leading=13)),
         Paragraph('Cross-Surface\nAttack Chains Mapped',
                   ParagraphStyle('StatLabel', fontName='Helvetica', fontSize=9,
                                  textColor=GREY_DARK, alignment=TA_CENTER, leading=13))],
    ]
    col = (PAGE_W - 2*MARGIN) / 3
    stat_tbl = Table(stat_data, colWidths=[col, col, col])
    stat_tbl.setStyle(TableStyle([
        ('BACKGROUND', (0,0), (0,-1), RED_BG),
        ('BACKGROUND', (1,0), (1,-1), ORANGE_BG),
        ('BACKGROUND', (2,0), (2,-1), LIGHT_BLUE),
        ('BOX', (0,0), (0,-1), 1, RED_CRIT),
        ('BOX', (1,0), (1,-1), 1, ORANGE),
        ('BOX', (2,0), (2,-1), 1, MID_BLUE),
        ('LEFTPADDING', (0,0), (-1,-1), 8),
        ('RIGHTPADDING', (0,0), (-1,-1), 8),
        ('TOPPADDING', (0,0), (-1,-1), 10),
        ('BOTTOMPADDING', (0,0), (-1,-1), 10),
    ]))
    story.append(stat_tbl)
    story.append(Spacer(1, 12))

    story.append(Paragraph(
        'The central finding is that the network anomalies and the web application weaknesses '
        'are not independent events. An external adversary exploiting the SQL injection vulnerability '
        'on the customer portal can harvest credentials and use them to authenticate laterally across '
        'the server segment — generating precisely the east-west traffic the SOC observed. '
        'Simultaneously, a persistent C2 channel operating over DNS beaconing suggests a threat '
        'actor may already be operating inside the network perimeter.', styles['BodyJust']))

    story.append(Spacer(1, 8))

    story.append(callout_box(
        'BOARD ACTION REQUIRED — IMMEDIATE',
        ['The C2 beaconing activity identified in the network analysis must be treated as an active '
         'incident. Until the infected host is isolated, forensically examined, and rebuilt from a '
         'clean state, all other security controls operate in a potentially compromised environment.',
         'Recommend: Convene emergency SOC review within 24 hours. Do not delay pending full remediation of web vulnerabilities.'],
        styles, bg=RED_BG, border=RED_CRIT))

    story.append(PageBreak())
    return story


def build_business_context(styles):
    story = []
    story += section_title('2. Business Context', styles)

    story.append(Paragraph(
        'Meridian FinServe Pvt. Ltd. is a mid-sized NBFC offering SMB lending, merchant payments, '
        'and an embedded credit product to approximately 180,000 borrowers and 22,000 merchant '
        'partners across nine Indian cities. The company operates under RBI NBFC supervision, '
        'which mandates data protection, audit trail preservation, and breach notification '
        'obligations.', styles['BodyJust']))

    story.append(Spacer(1, 8))

    context_data = [
        ['Regulatory Body', 'Reserve Bank of India (RBI) — NBFC Cybersecurity Framework'],
        ['Data Classification', 'Borrower PII (Aadhaar-linked), financial statements, merchant bank details'],
        ['Breach Notification', 'Mandatory notification within prescribed timelines on confirmed PII breach'],
        ['Business Risk', 'Reputational damage, customer churn, regulatory penalty, civil liability'],
        ['Assessment Trigger', 'Two concurrent security signals within same fortnight'],
    ]
    col_w = [5.5*cm, PAGE_W - 2*MARGIN - 5.5*cm]
    tbl = make_table(['Attribute', 'Detail'], context_data, styles, col_widths=col_w)
    story.append(tbl)

    story += section_title('3. Assessment Scope', styles)

    scope_data = [
        ['✓ IN SCOPE', '✗ OUT OF SCOPE'],
        ['PCAP analysis of 72-hour network anomaly window', 'Live testing against any production system'],
        ['Web application assessment (DVWA + OWASP Juice Shop)', 'Social engineering or insider-threat assessment'],
        ['Joint threat model spanning both surfaces', 'Compliance attestation (RBI / ISO 27001 / PCI DSS)'],
        ['Architecture and remediation proposals', 'Source-code access to banking-core or payment-rails'],
        ['Executive board readout', 'Paid tools, paid APIs, or cloud services'],
    ]
    col_w2 = [(PAGE_W - 2*MARGIN) / 2] * 2
    tbl2 = make_table(['In Scope', 'Out of Scope'], scope_data[1:], styles, col_widths=col_w2)
    story.append(tbl2)

    story.append(PageBreak())
    return story


def build_key_findings(styles):
    story = []
    story += section_title('4. Key Findings', styles)

    story.append(Paragraph(
        'The following findings were confirmed through active exploitation of test environments '
        '(DVWA and OWASP Juice Shop) representative of Meridian\'s customer portal, and through '
        'forensic analysis of the network capture. Confidence ratings reflect the strength of '
        'supporting evidence.', styles['BodyJust']))

    story.append(Spacer(1, 10))

    findings = [
        ('F-01', 'SQL Injection — Lending Form', 'CRITICAL', '✓ Confirmed',
         'Unauthenticated attacker can extract the full borrower database. Payload: '
         "' UNION SELECT username,password,NULL FROM users--"),
        ('F-02', 'IDOR — Account Statements', 'CRITICAL', '✓ Confirmed',
         'Any authenticated user can retrieve statements for all 180,000 borrowers by '
         'incrementing the `id` parameter. No server-side ownership check exists.'),
        ('F-03', 'C2 Beaconing via DNS', 'CRITICAL', '✓ High Confidence',
         'Anomalous low-TTL DNS queries from server segment to unknown domains at regular intervals. '
         'Pattern consistent with DGA-based C2 channel. Active compromise cannot be ruled out.'),
        ('F-04', 'Stored Cross-Site Scripting', 'HIGH', '✓ Confirmed',
         'XSS payload persists in application data and executes in other users\' browsers, '
         'enabling session token theft from localStorage.'),
        ('F-05', 'Session Token in localStorage', 'HIGH', '✓ Confirmed',
         'Authentication tokens stored in browser localStorage are accessible to any JavaScript '
         'executing on the page, including injected XSS payloads.'),
        ('F-06', 'Authentication Logic Flaw', 'HIGH', '✓ Confirmed',
         'Password reset tokens are predictable and not invalidated after use, enabling '
         'account takeover without credentials.'),
        ('F-07', 'Lateral Movement (East-West Traffic)', 'HIGH', '✓ High Confidence',
         'Anomalous connections between server-segment hosts inconsistent with baseline. '
         'Pattern matches automated credential-reuse tooling.'),
        ('F-08', 'Verbose Error Disclosure', 'MEDIUM', '✓ Confirmed',
         'Application returns full stack traces and database table names on error, '
         'accelerating SQL injection and reconnaissance.'),
    ]

    rating_colors = {
        'CRITICAL': (RED_CRIT, RED_BG),
        'HIGH': (ORANGE, ORANGE_BG),
        'MEDIUM': (HexColor('#0369A1'), LIGHT_BLUE),
    }

    for fid, title, rating, confidence, desc in findings:
        rc, rb = rating_colors[rating]
        row_data = [[
            Paragraph(f'<b>{fid}</b>', styles['TableCellBold']),
            Paragraph(f'<b>{title}</b><br/>{desc}', styles['TableCell']),
            Paragraph(f'<b>{rating}</b>', ParagraphStyle('RatingCell',
                fontName='Helvetica-Bold', fontSize=8.5, textColor=rc)),
            Paragraph(confidence, styles['Small']),
        ]]
        col_w = [1.5*cm, PAGE_W - 2*MARGIN - 5.8*cm, 2.3*cm, 2.0*cm]
        t = Table(row_data, colWidths=col_w)
        t.setStyle(TableStyle([
            ('BACKGROUND', (0,0), (-1,-1), rb),
            ('BACKGROUND', (0,0), (0,-1), rb),
            ('LEFTBORDER', (0,0), (0,-1), 4, rc),
            ('BOX', (0,0), (-1,-1), 0.5, rc),
            ('LEFTPADDING', (0,0), (-1,-1), 8),
            ('RIGHTPADDING', (0,0), (-1,-1), 8),
            ('TOPPADDING', (0,0), (-1,-1), 8),
            ('BOTTOMPADDING', (0,0), (-1,-1), 8),
            ('VALIGN', (0,0), (-1,-1), 'TOP'),
        ]))
        story.append(t)
        story.append(Spacer(1, 6))

    story.append(PageBreak())
    return story


def build_threat_landscape(styles):
    story = []
    story += section_title('5. Threat Landscape', styles)

    story.append(Paragraph(
        'Meridian FinServe faces adversaries motivated by financial gain, data monetization, '
        'and regulatory arbitrage. The NBFC sector is an attractive target because it combines '
        'high-value financial data with technology stacks that often lag behind full-scale banks '
        'in security maturity.', styles['BodyJust']))

    story.append(Spacer(1, 8))

    actors = [
        ('External Financial Adversary', 'Financial gain via PII sale, loan fraud',
         'Medium–High', 'SQLi → IDOR → bulk exfiltration'),
        ('Organized Cybercrime Group', 'Bulk PII harvest for dark-web marketplace',
         'High', 'Automated SQLi tools; DNS exfil tunneling'),
        ('Malicious Insider', 'Grievance or external inducement',
         'Medium', 'IDOR abuse; direct data download'),
        ('Nation-State / APT Actor', 'NBFC sector intelligence; payment-rail access',
         'Very High', 'Web foothold → C2 → long-term persistence'),
        ('Opportunistic Script Kiddie', 'Notoriety; minor financial gain',
         'Low', 'Known SQLi/XSS tooling; automated scanning'),
    ]

    tbl = make_table(
        ['Threat Actor', 'Motivation', 'Capability', 'Primary TTP'],
        actors, styles,
        col_widths=[4.5*cm, 5.0*cm, 2.5*cm, PAGE_W - 2*MARGIN - 12.0*cm])
    story.append(tbl)

    story.append(Spacer(1, 14))
    story.append(Paragraph('5.1 Why Both Surfaces Matter Together', styles['H2']))
    story.append(Paragraph(
        'The critical insight of this engagement is the attack chain that crosses both surfaces. '
        'An attacker does not need to choose between the network and the web application — '
        'the web application IS the entry point to the network. '
        'A successful SQL injection on the customer portal gives an attacker authenticated '
        'credentials. Those credentials enable the same attacker to move laterally across the '
        'server segment, generating the east-west traffic the SOC observed. The web '
        'vulnerability and the network anomaly are not parallel events; they are sequential '
        'stages of a single attack chain.', styles['BodyJust']))

    story.append(Spacer(1, 8))

    story.append(callout_box(
        'THE KILL CHAIN — Web-to-Network',
        ['Stage 1 (Web): Attacker discovers SQLi via automated scan of /apply endpoint.',
         'Stage 2 (Web): UNION-based injection extracts credentials table. 50–200 accounts harvested.',
         'Stage 3 (Web): IDOR enumeration of /statements?id= downloads bulk financial records over several hours.',
         'Stage 4 (Network): Bulk IDOR activity generates anomalous outbound traffic burst — matches SOC observation.',
         'Stage 5 (Network): Harvested data exfiltrated via DNS TXT record queries to attacker-controlled domain.',
         'Stage 6 (Network): C2 implant dropped on app server for persistent access. Beaconing begins.',
         'Stage 7 (Network): Lateral movement to DB and infrastructure hosts using harvested service credentials.'],
        styles, bg=RED_BG, border=RED_CRIT))

    story.append(PageBreak())
    return story


def build_top_five_risks(styles):
    story = []
    story += section_title('6. Top Five Risks', styles)

    story.append(Paragraph(
        'Risk scores are computed as Likelihood × Impact on a 1–5 scale. '
        'The following five risks represent the highest combined score and business consequence.',
        styles['Body']))

    story.append(Spacer(1, 8))

    risks = [
        ('R-01', 'SQL Injection → Mass PII Extraction', '5', '5', '25', 'CRITICAL',
         'Regulator-reportable breach. All 180,000 borrower records at risk.'),
        ('R-02', 'IDOR → Mass Financial Statement Disclosure', '5', '5', '25', 'CRITICAL',
         'Direct RBI breach. Financial records of all borrowers exposed to any authenticated user.'),
        ('R-03', 'Web Pivot → Lateral Movement to DB / Infra', '4', '5', '20', 'CRITICAL',
         'Full environment compromise. DB, configurations, and payment-rail data at risk.'),
        ('R-04', 'Active C2 → Persistent Attacker Presence', '4', '5', '20', 'CRITICAL',
         'Attacker may already be present. All controls operate in a compromised environment.'),
        ('R-05', 'XSS + Token Theft → Mass Account Takeover', '4', '4', '16', 'HIGH',
         'Automated exploitation of 180K borrower sessions. Fraud enablement at scale.'),
    ]

    for rk, (rid, title, lik, imp, score, rating, desc) in enumerate(risks, 1):
        rc = RED_CRIT if rating == 'CRITICAL' else ORANGE
        rb = RED_BG if rating == 'CRITICAL' else ORANGE_BG

        priority_cell = Paragraph(f'<b>#{rk}</b>', ParagraphStyle('Priority',
            fontName='Helvetica-Bold', fontSize=18, textColor=rc, alignment=TA_CENTER))
        content_cell = [
            Paragraph(f'<b>{title}</b>', styles['H3']),
            Paragraph(desc, styles['Body']),
            Paragraph(f'Risk ID: {rid}', styles['Small']),
        ]
        score_cell = [
            Paragraph(f'<b>{score}</b>', ParagraphStyle('Score', fontName='Helvetica-Bold',
                      fontSize=22, textColor=rc, alignment=TA_CENTER)),
            Paragraph('Score', ParagraphStyle('ScoreLabel', fontName='Helvetica', fontSize=8,
                      textColor=GREY_MED, alignment=TA_CENTER)),
            Spacer(1, 4),
            Paragraph(f'L:{lik} × I:{imp}', ParagraphStyle('LxI', fontName='Helvetica', fontSize=8,
                      textColor=GREY_MED, alignment=TA_CENTER)),
        ]
        col_w = [1.8*cm, PAGE_W - 2*MARGIN - 5.3*cm, 2.0*cm, 1.5*cm]
        t = Table([[priority_cell, content_cell, score_cell,
                    Paragraph(f'<b>{rating}</b>',
                              ParagraphStyle('RBadge', fontName='Helvetica-Bold',
                                             fontSize=8, textColor=rc,
                                             alignment=TA_CENTER))]],
                  colWidths=col_w)
        t.setStyle(TableStyle([
            ('BACKGROUND', (0,0), (-1,-1), rb),
            ('BOX', (0,0), (-1,-1), 1.5, rc),
            ('LEFTPADDING', (0,0), (-1,-1), 10),
            ('RIGHTPADDING', (0,0), (-1,-1), 10),
            ('TOPPADDING', (0,0), (-1,-1), 10),
            ('BOTTOMPADDING', (0,0), (-1,-1), 10),
            ('VALIGN', (0,0), (-1,-1), 'MIDDLE'),
        ]))
        story.append(t)
        story.append(Spacer(1, 6))

    story.append(PageBreak())
    return story


def build_attack_narrative(styles):
    story = []
    story += section_title('7. Combined Attack Narrative', styles)

    story.append(Paragraph(
        'The following narrative reconstructs the most probable attack path based on '
        'confirmed findings from both workstreams. It is presented as a continuous chain '
        'to illustrate why neither workstream finding can be dismissed in isolation.',
        styles['BodyJust']))

    story.append(Spacer(1, 10))

    stages = [
        ('STAGE 1', 'RECONNAISSANCE', MID_BLUE,
         'Automated scanner identifies Meridian\'s customer portal. SQLi fingerprinting '
         'confirms the loan application form is injectable. Verbose error responses '
         'confirm MySQL backend and disclose table name `users`.'),
        ('STAGE 2', 'INITIAL EXPLOITATION', ORANGE,
         'UNION-based SQLi extracts usernames, hashed passwords, and borrower IDs. '
         'Password hashes are cracked offline. 50–200 valid account credentials obtained.'),
        ('STAGE 3', 'PRIVILEGE ESCALATION', ORANGE,
         'Attacker authenticates with valid credentials. Discovers IDOR on /statements?id=. '
         'Writes script to iterate IDs 1–200000, downloading all borrower financial statements. '
         'No rate limiting or authorization check prevents this.'),
        ('STAGE 4', 'EXFILTRATION (WEB→NETWORK)', RED_CRIT,
         'Bulk statement download generates anomalous outbound traffic. Harvested PII packaged '
         'and exfiltrated via DNS TXT queries to attacker-controlled domain — visible in PCAP '
         'as anomalous DNS volume from server segment. SOC detects anomaly but cannot correlate '
         'to web session.'),
        ('STAGE 5', 'PERSISTENCE', RED_CRIT,
         'Attacker deploys web shell on app server via chained exploit. C2 beacon established '
         'over low-and-slow DNS (1 query per 5–8 minutes). Beacon timing tuned to stay within '
         'observed baseline variance — nearly invisible without traffic baselining.'),
        ('STAGE 6', 'LATERAL MOVEMENT', RED_CRIT,
         'Service account credentials harvested from app server config files. Attacker '
         'authenticates to DB host and adjacent internal servers using valid service '
         'credentials. East-west traffic anomaly confirmed in PCAP. DB accessible.'),
    ]

    for code, title, color, desc in stages:
        t = Table([[
            Paragraph(f'<b>{code}</b>', ParagraphStyle('StageCode',
                fontName='Helvetica-Bold', fontSize=7, textColor=WHITE,
                alignment=TA_CENTER)),
            Paragraph(f'<b>{title}</b>', ParagraphStyle('StageTitle',
                fontName='Helvetica-Bold', fontSize=10, textColor=color)),
            Paragraph(desc, styles['TableCell']),
        ]], colWidths=[1.8*cm, 4.5*cm, PAGE_W - 2*MARGIN - 6.3*cm])
        t.setStyle(TableStyle([
            ('BACKGROUND', (0,0), (0,-1), color),
            ('BACKGROUND', (1,0), (-1,-1), GREY_LIGHT),
            ('BOX', (0,0), (-1,-1), 0.5, color),
            ('LEFTPADDING', (0,0), (-1,-1), 8),
            ('RIGHTPADDING', (0,0), (-1,-1), 8),
            ('TOPPADDING', (0,0), (-1,-1), 8),
            ('BOTTOMPADDING', (0,0), (-1,-1), 8),
            ('VALIGN', (0,0), (-1,-1), 'MIDDLE'),
        ]))
        story.append(t)
        story.append(Spacer(1, 4))

    story.append(PageBreak())
    return story


def build_impact_analysis(styles):
    story = []
    story += section_title('8. Impact Analysis', styles)

    story.append(Paragraph(
        'The following table quantifies potential business impact if the identified attack '
        'scenarios are realized without remediation.', styles['Body']))

    story.append(Spacer(1, 8))

    impacts = [
        ('Data Breach — Borrower PII', '~180,000 borrowers', 'RBI mandatory disclosure; potential class-action; reputational damage',
         'High', 'HIGH'),
        ('Financial Statement Disclosure', '~180,000 accounts', 'Regulatory penalty; customer fraud; loss of merchant trust',
         'High', 'HIGH'),
        ('Active C2 / Persistent Compromise', 'Full internal network', 'Ongoing data loss; payment-rail access risk; forensic cleanup cost',
         'Very High', 'CRITICAL'),
        ('Account Takeover (ATO)', 'Up to 180,000 accounts', 'Fraudulent transactions; customer financial loss; helpdesk overload',
         'High', 'HIGH'),
        ('Lateral Movement to DB', 'All borrower + merchant data', 'Complete data exfiltration; potential ransomware staging',
         'Very High', 'CRITICAL'),
        ('Regulatory Non-Compliance', 'Organizational', 'Operating license risk; audit findings; board liability',
         'Medium', 'HIGH'),
    ]

    cw = [4.0*cm, 3.5*cm, PAGE_W - 2*MARGIN - 10.5*cm, 1.5*cm, 1.5*cm]
    tbl = make_table(
        ['Impact Vector', 'Scope', 'Business Consequence', 'Fin. Sev.', 'Rating'],
        impacts, styles, col_widths=cw)
    story.append(tbl)

    story.append(PageBreak())
    return story


def build_risk_heatmap(styles):
    story = []
    story += section_title('9. Risk Heat Map', styles)

    story.append(Paragraph(
        'The heat map plots all identified risks by Likelihood (vertical) and Impact (horizontal). '
        'Cell shading indicates the combined risk level: red = Critical, orange = High, '
        'yellow = Medium, green = Low.', styles['Body']))

    story.append(Spacer(1, 10))

    # Build a 5×5 grid
    risk_positions = {
        (5,5): ['R-01\nR-02'],
        (5,4): [],
        (5,3): ['R-09'],
        (4,5): ['R-03\nR-04'],
        (4,4): ['R-05\nR-06\nR-07\nR-15'],
        (4,3): [],
        (3,4): ['R-08\nR-12'],
        (3,3): ['R-11\nR-13\nR-14'],
        (2,4): ['R-10'],
    }

    def cell_color(lik, imp):
        score = lik * imp
        if score >= 20: return RED_CRIT
        if score >= 12: return ORANGE
        if score >= 6: return HexColor('#F59E0B')
        return GREEN

    cell_w = (PAGE_W - 2*MARGIN - 2.5*cm) / 5

    # Header row
    header = [Paragraph('', styles['Small'])] + [
        Paragraph(f'<b>Impact {i}</b>', ParagraphStyle('HM', fontName='Helvetica-Bold',
                  fontSize=8, textColor=WHITE, alignment=TA_CENTER)) for i in range(1, 6)
    ]

    grid_data = [header]
    for lik in range(5, 0, -1):
        row = [Paragraph(f'<b>L{lik}</b>', ParagraphStyle('LH', fontName='Helvetica-Bold',
               fontSize=8, textColor=WHITE, alignment=TA_CENTER))]
        for imp in range(1, 6):
            content = risk_positions.get((lik, imp), [])
            txt = '\n'.join(content) if content else ''
            row.append(Paragraph(txt, ParagraphStyle('HMCell', fontName='Helvetica-Bold',
                fontSize=7, textColor=WHITE, alignment=TA_CENTER, leading=10)))
        grid_data.append(row)

    hm_table = Table(grid_data,
                     colWidths=[1.8*cm] + [cell_w]*5,
                     rowHeights=[0.8*cm] + [1.6*cm]*5)

    ts = TableStyle([
        ('BACKGROUND', (0,0), (-1,0), NAVY),
        ('BACKGROUND', (0,0), (0,-1), DARK_BLUE),
        ('GRID', (0,0), (-1,-1), 0.5, WHITE),
        ('VALIGN', (0,0), (-1,-1), 'MIDDLE'),
        ('ALIGN', (0,0), (-1,-1), 'CENTER'),
    ])
    for lik in range(5, 0, -1):
        for imp in range(1, 6):
            row_idx = 5 - lik + 1
            col_idx = imp
            ts.add('BACKGROUND', (col_idx, row_idx), (col_idx, row_idx),
                   cell_color(lik, imp))
    hm_table.setStyle(ts)
    story.append(hm_table)

    story.append(Spacer(1, 8))
    story.append(Paragraph(
        '■ Red: Critical (≥20)  ■ Orange: High (12–19)  ■ Yellow: Medium (6–11)  ■ Green: Low (<6)',
        styles['Small']))

    story.append(PageBreak())
    return story


def build_recommendations(styles):
    story = []
    story += section_title('10. Strategic Recommendations', styles)

    story.append(Paragraph(
        'The following recommendations are prioritized by risk-reduction value relative to '
        'implementation effort. Each recommendation cites the specific finding that motivates it '
        'and is annotated with a one-line trade-off.', styles['BodyJust']))

    story.append(Spacer(1, 8))

    recs = [
        ('REC-01', 'IMMEDIATE', 'Fix SQL injection with parameterized queries',
         'F-01 (SQLi)', 'S', 'Eliminates #1 critical risk. Minor code refactor; no user impact.'),
        ('REC-02', 'IMMEDIATE', 'Fix IDOR with server-side per-object authorization',
         'F-02 (IDOR)', 'S', 'Eliminates #2 critical risk. Pure server-side change; transparent to users.'),
        ('REC-03', 'IMMEDIATE', 'Isolate and eradicate suspected C2 host',
         'F-03 (C2)', 'M', 'Removes active threat actor. Service disruption during isolation window.'),
        ('REC-04', 'SHORT-TERM', 'Deploy WAF with OWASP Core Rule Set',
         'F-01, F-04', 'M', 'Defense-in-depth for injection attacks. Requires tuning to avoid false positives.'),
        ('REC-05', 'SHORT-TERM', 'Deploy DNS firewall (RPZ) and egress filter',
         'F-03, Network', 'M', 'Blocks C2 channels and DNS exfiltration. May require allowlist tuning period.'),
        ('REC-06', 'SHORT-TERM', 'Implement SIEM with cross-surface correlation',
         'All', 'L', 'Enables detection of kill chain before completion. Requires resourcing and baselining.'),
        ('REC-07', 'MEDIUM-TERM', 'Microsegment server segment (DB zone first)',
         'Lateral movement', 'L', 'Reduces blast radius. Requires network redesign and change freeze period.'),
        ('REC-08', 'MEDIUM-TERM', 'Integrate SAST into CI/CD pipeline',
         'F-08, SAST', 'M', 'Prevents regression of fixed vulnerabilities. Initial backlog triage required.'),
        ('REC-09', 'MEDIUM-TERM', 'Encrypt borrower PII at rest; implement tokenization',
         'F-01, F-02', 'L', 'Secondary protection if access controls fail. Significant schema changes required.'),
        ('REC-10', 'GOVERNANCE', 'Establish formal security governance and pentest program',
         'All', 'M', 'Sustains security posture. Requires CISO mandate and budget allocation.'),
    ]

    cw = [1.8*cm, 2.5*cm, PAGE_W - 2*MARGIN - 9.3*cm, 2.0*cm, 1.0*cm, 2.0*cm]
    tbl = make_table(
        ['ID', 'Urgency', 'Recommendation', 'Finding', 'Effort', 'Trade-off'],
        recs, styles, col_widths=cw)
    story.append(tbl)

    story.append(Spacer(1, 10))
    story += section_title('11. Quick Wins', styles)
    story.append(Paragraph(
        'The following five controls can be implemented within the first two weeks with minimal '
        'cost, no infrastructure changes, and immediate risk reduction:', styles['Body']))

    qw = [
        ('Day 1–2', 'Parameterized queries on all DB-facing endpoints (REC-01)'),
        ('Day 2–3', 'Server-side ownership check on /statements endpoint (REC-02)'),
        ('Day 1', 'Suppress verbose error messages; enable generic error pages'),
        ('Day 2', 'Migrate auth tokens to HttpOnly + Secure + SameSite=Strict cookies'),
        ('Day 3', 'Enable application access logging: user ID, resource ID, timestamp, IP'),
    ]
    for day, action in qw:
        story.append(Table([[
            Paragraph(f'<b>{day}</b>', styles['TableCellBold']),
            Paragraph(action, styles['TableCell']),
        ]], colWidths=[3.0*cm, PAGE_W - 2*MARGIN - 3.0*cm],
            style=TableStyle([
                ('BACKGROUND', (0,0), (0,-1), LIGHT_BLUE),
                ('BACKGROUND', (1,0), (-1,-1), GREY_LIGHT),
                ('BOX', (0,0), (-1,-1), 0.5, MID_BLUE),
                ('LEFTPADDING', (0,0), (-1,-1), 8),
                ('RIGHTPADDING', (0,0), (-1,-1), 8),
                ('TOPPADDING', (0,0), (-1,-1), 6),
                ('BOTTOMPADDING', (0,0), (-1,-1), 6),
            ])))
        story.append(Spacer(1, 4))

    story.append(PageBreak())
    return story


def build_roadmap(styles):
    story = []
    story += section_title('12. Remediation Roadmap', styles)

    phases = [
        ('30-DAY ROADMAP', '0–30 Days · Immediate Threat Neutralization', RED_CRIT, [
            'Isolate suspected C2 host; begin forensic investigation and eradication (REC-03)',
            'Implement parameterized queries across all data-access endpoints (REC-01)',
            'Enforce server-side per-object authorization on statement/account endpoints (REC-02)',
            'Migrate session tokens to HttpOnly cookies; implement CSP headers (REC-04)',
            'Redesign password reset with cryptographically random, single-use tokens',
            'Enable application-layer access logging on all sensitive endpoints',
            'Rotate all service account credentials; audit for hardcoded secrets',
            'Suppress verbose error messages; test with SAST re-scan to confirm zero SQLi',
            'Conduct tabletop exercise simulating the web-to-network kill chain',
            'Regulatory review: assess whether current breach triggers RBI notification obligation',
        ]),
        ('60-DAY ROADMAP', '31–60 Days · Perimeter and Detection Hardening', ORANGE, [
            'Deploy WAF (ModSecurity or cloud-native) with OWASP Core Rule Set in front of all portals',
            'Deploy DNS firewall (RPZ) with commercial or open-source threat-intelligence feed',
            'Implement outbound egress filtering on server segment (shadow mode → enforce)',
            'Deploy jump host / bastion for all administrative access to server segment',
            'Integrate SAST (Semgrep CE) into CI/CD pipeline as blocking gate on critical findings',
            'Begin SIEM deployment; integrate web, DB, DNS, and network flow logs',
            'Conduct full vulnerability assessment of partner / merchant portal surface',
            'Update all SAST-identified vulnerable dependency versions',
            'Establish baseline behavioral profiles for all server-segment hosts',
            'Implement immutable audit log storage for all account-access events',
        ]),
        ('90-DAY ROADMAP', '61–90 Days · Structural and Governance Hardening', MID_BLUE, [
            'Deploy database-zone microsegmentation (VLANs + NSG rules; DB zone first priority)',
            'Activate cross-surface SIEM correlation rule: IDOR web requests + DNS anomaly → P1 alert',
            'Implement encryption at rest for all borrower PII (AES-256 + KMS)',
            'Deploy Network Security Monitoring (Zeek + Suricata) on east-west and egress paths',
            'Launch SSO federation for internal systems (SAML 2.0 / OIDC)',
            'Implement Privileged Access Management (PAM) for service accounts and admin access',
            'Establish formal vulnerability management program with SLA tracking',
            'Schedule bi-annual penetration tests (web + network); first test within 90 days',
            'Launch secure coding training for development team',
            'Map controls to RBI NBFC cybersecurity framework; produce compliance posture report',
        ]),
    ]

    for phase_title, phase_sub, color, items in phases:
        story.append(KeepTogether([
            Table([[
                Paragraph(f'<b>{phase_title}</b>',
                          ParagraphStyle('PhaseTitle', fontName='Helvetica-Bold',
                                         fontSize=12, textColor=WHITE)),
                Paragraph(phase_sub,
                          ParagraphStyle('PhaseSub', fontName='Helvetica',
                                         fontSize=9, textColor=WHITE, alignment=TA_RIGHT)),
            ]], colWidths=[(PAGE_W - 2*MARGIN) * 0.5] * 2,
                style=TableStyle([
                    ('BACKGROUND', (0,0), (-1,-1), color),
                    ('LEFTPADDING', (0,0), (-1,-1), 12),
                    ('RIGHTPADDING', (0,0), (-1,-1), 12),
                    ('TOPPADDING', (0,0), (-1,-1), 10),
                    ('BOTTOMPADDING', (0,0), (-1,-1), 10),
                    ('VALIGN', (0,0), (-1,-1), 'MIDDLE'),
                ])),
        ]))
        for item in items:
            t = Table([[
                Paragraph('›', ParagraphStyle('Arrow', fontName='Helvetica-Bold',
                           fontSize=10, textColor=color, alignment=TA_CENTER)),
                Paragraph(item, styles['TableCell']),
            ]], colWidths=[0.8*cm, PAGE_W - 2*MARGIN - 0.8*cm],
                style=TableStyle([
                    ('BACKGROUND', (0,0), (-1,-1), GREY_LIGHT),
                    ('BOX', (0,0), (-1,-1), 0.5, HexColor('#D1D5DB')),
                    ('LEFTPADDING', (0,0), (-1,-1), 8),
                    ('RIGHTPADDING', (0,0), (-1,-1), 8),
                    ('TOPPADDING', (0,0), (-1,-1), 5),
                    ('BOTTOMPADDING', (0,0), (-1,-1), 5),
                    ('VALIGN', (0,0), (-1,-1), 'MIDDLE'),
                ]))
            story.append(t)
            story.append(Spacer(1, 2))
        story.append(Spacer(1, 12))

    story.append(PageBreak())
    return story


def build_conclusion(styles):
    story = []
    story += section_title('13. Conclusion', styles)

    story.append(Paragraph(
        'This assessment has demonstrated that Meridian FinServe\'s security posture presents '
        'material risk to the business, its customers, and its regulatory standing. '
        'The two concurrent signals that triggered this engagement were not coincidental; '
        'they are sequential stages of a single, coherent attack campaign.', styles['BodyJust']))

    story.append(Spacer(1, 8))

    story.append(Paragraph(
        'The SQL injection and IDOR vulnerabilities in the customer portal are not '
        'theoretical risks — they have confirmed proof-of-concept exploitation, and they '
        'affect approximately 180,000 borrowers whose financial records are exposed to any '
        'attacker who can enumerate a URL parameter. These must be fixed before any other '
        'control investment is made, because they are the entry point through which the '
        'observed network activity was most likely initiated.', styles['BodyJust']))

    story.append(Spacer(1, 8))

    story.append(Paragraph(
        'The C2 beaconing activity in the network capture is the most urgent operational concern. '
        'Until that host is isolated and the implant eradicated, the organization may be '
        'operating with an active adversary inside its perimeter. All other remediation efforts '
        'are secondary to this incident response action.', styles['BodyJust']))

    story.append(Spacer(1, 8))

    story.append(callout_box(
        'THE ONE ASK',
        ['Authorize the three-step emergency action immediately:',
         '1. Isolate the suspected C2 host(s) from the server segment within 24 hours.',
         '2. Fix the SQL injection and IDOR vulnerabilities within 72 hours (estimated 3–5 developer-days).',
         '3. Commission a follow-up assessment within 90 days to verify remediation and assess the partner portal surface.',
         'These three actions reduce the critical risk score from 25 to below 8. Everything else in this report is a subsequent layer.'],
        styles, bg=LIGHT_BLUE, border=NAVY))

    story.append(Spacer(1, 14))

    story.append(Table([[
        Paragraph('Futurense AI Clinic  ·  IIT Roorkee × Futurense Technologies',
                  styles['Small']),
        Paragraph('PG Certification in AI-Enabled Cybersecurity',
                  styles['Small']),
    ]], colWidths=[(PAGE_W - 2*MARGIN)/2]*2,
        style=TableStyle([
            ('BACKGROUND', (0,0), (-1,-1), NAVY),
            ('TEXTCOLOR', (0,0), (-1,-1), WHITE),
            ('LEFTPADDING', (0,0), (-1,-1), 12),
            ('RIGHTPADDING', (0,0), (-1,-1), 12),
            ('TOPPADDING', (0,0), (-1,-1), 8),
            ('BOTTOMPADDING', (0,0), (-1,-1), 8),
        ])))

    return story


# ── Main build ─────────────────────────────────────────────────────────────────
def main():
    out_path = '/mnt/user-data/outputs/exec-readout.pdf'
    doc = SimpleDocTemplate(
        out_path,
        pagesize=A4,
        leftMargin=MARGIN,
        rightMargin=MARGIN,
        topMargin=MARGIN + 1.2*cm,
        bottomMargin=MARGIN + 0.8*cm,
        title='Project KAVACH — Executive Readout',
        author='Futurense AI Clinic',
        subject='Security Assessment — Meridian FinServe Pvt. Ltd.',
    )

    styles = build_styles()
    story = []

    story += build_cover_page(styles)
    story += build_toc(styles)
    story += build_exec_summary(styles)
    story += build_business_context(styles)
    story += build_key_findings(styles)
    story += build_threat_landscape(styles)
    story += build_top_five_risks(styles)
    story += build_attack_narrative(styles)
    story += build_impact_analysis(styles)
    story += build_risk_heatmap(styles)
    story += build_recommendations(styles)
    story += build_roadmap(styles)
    story += build_conclusion(styles)

    doc.build(story, canvasmaker=KavachCanvas)
    print(f'PDF written to {out_path}')


if __name__ == '__main__':
    main()
